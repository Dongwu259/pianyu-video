    "@remotion/fonts": "4.0.390",
    "@remotion/media": "4.0.390",
    "@remotion/motion-blur": "4.0.390",
    "@remotion/player": "4.0.390",
    "@remotion/renderer": "4.0.390",
    "@remotion/three": "4.0.390"
  }
