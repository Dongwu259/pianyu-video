{
  "name": "promo-video-generator",
  "version": "1.7.1",
  "description": "片语 - AI 全自动视频制作器，一句话出片（Windows 桌面视频制作工具：宣传片 / vlog / 口播 / 教程 / 混剪）",
  "main": "out/main/index.js",
  "author": "东吴摄影",
  "license": "UNLICENSED",
  "scripts": {
    "dev": "chcp 65001>nul & electron-vite dev",
    "build": "electron-vite build",
    "start": "chcp 65001>nul & electron-vite build && electron-vite preview",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "package": "npm run build && electron-builder --dir",
    "dist": "npm run build && electron-builder --win",
    "dist:nsis": "npm run build && electron-builder --win nsis",
    "dist:appx": "npm run build && electron-builder --win appx",
    "postinstall": "remotion browser ensure"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@react-three/drei": "^9.122.0",
    "@react-three/fiber": "^8.18.0",
    "@remotion/bundler": "4.0.390",
    "@remotion/cli": "4.0.390",
    "@remotion/fonts": "4.0.390",
    "@remotion/media": "4.0.390",
    "@remotion/motion-blur": "4.0.390",
    "@remotion/player": "4.0.390",
    "@remotion/renderer": "4.0.390",
    "@remotion/three": "4.0.390",
    "bufferutil": "^4.1.0",
    "electron-store": "^8.2.0",
    "electron-updater": "^6.8.9",
    "execa": "^5.1.1",
    "koffi": "^3.1.4",
    "lucide-react": "^1.24.0",
    "opentype.js": "^1.3.4",
    "pngjs": "^7.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "three": "^0.180.0",
    "uiohook-napi": "^1.5.5",
    "utf-8-validate": "^6.0.6",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@remotion/eslint-config": "4.0.390",
    "@resvg/resvg-js": "^2.6.2",
    "@types/node": "^20.14.0",
    "@types/opentype.js": "^1.3.10",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@types/three": "^0.180.0",
    "@vitejs/plugin-react": "^4.3.1",
    "electron": "^32.1.0",
    "electron-builder": "^25.0.5",
    "electron-vite": "^2.3.0",
    "png-to-ico": "^3.0.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.5.4",
    "vite": "^5.4.6"
  },
  "overrides": {
